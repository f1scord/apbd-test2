<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- EXAM MACHINE = net9.0. If your clone won't build at home and you only
         have .NET 8 or 10 installed, change this one line to net8.0 / net10.0. -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- EF Core (required for CodeFirst + migrations) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0" />
    <!-- Swagger UI for testing endpoints in the browser -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>
</Project>
